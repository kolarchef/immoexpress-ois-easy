# Kopiere diese Datei nach .env und trage deine echten Werte ein.
# NIEMALS die .env committen (steht in .gitignore).

PORT=8787
NODE_ENV=development

# Langes zufälliges Secret, z.B. mit: openssl rand -hex 32
BRAINY_WORKER_SECRET=ein-langes-sicheres-secret

# "live" = echte MANZ-Suche über Immoservice Austria
# "mock" = liefert Beispieldaten ohne Browser (zum Testen der App-Anbindung)
GRUNDBUCH_MODE=live

# Immoservice-Austria-Zugangsdaten (nur hier, nie im Code!)
ISA_EMAIL=IMMOSERVICE_EMAIL
ISA_PASSWORD=IMMOSERVICE_PASSWORT

# false = Browserfenster sichtbar (zum Debuggen), true = unsichtbar (Server)
HEADLESS=false
SLOW_MO_MS=150

# Debug-Snapshots (Screenshot + HTML ohne Passwörter) nach ./debug schreiben
DEBUG_DUMPS=true

# Optional: Pfad zu einem vorhandenen Chromium. Leer lassen, wenn der Browser
# per "npx playwright install chromium" installiert wurde.
CHROMIUM_PATH=
